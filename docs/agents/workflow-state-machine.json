{
  "schema_version": "1.0.0",
  "initial_state": "DRAFT",
  "terminal_states": ["COMPLETED", "CANCELLED"],
  "special_states": {
    "PAUSED": "Stores paused_from_state and resumes only after guards are rechecked.",
    "FAILED": "Stores failed_from_state, retryability and the immutable failed attempt."
  },
  "states": [
    "DRAFT", "SPECIFYING_TARGET_DATASET", "AWAITING_DATASET_SPECIFICATION_APPROVAL",
    "DERIVING_COMPONENT_REQUIREMENTS", "DISCOVERING_ACTIVITY_EVIDENCE",
    "DISCOVERING_TRANSCRIPTOMIC_EVIDENCE", "DISCOVERING_IDENTITY_AND_STRUCTURE_SOURCES",
    "DISCOVERING_SUPPORTING_METADATA", "VALIDATING_DISCOVERED_SOURCES",
    "BUILDING_SOURCE_INVENTORY", "PLANNING_ASSEMBLY_STRATEGIES", "EVALUATING_JOINABILITY",
    "IDENTIFYING_ASSEMBLY_GAPS", "GAP_DIRECTED_DISCOVERY", "COMPARING_ASSEMBLY_STRATEGIES",
    "AWAITING_ASSEMBLY_STRATEGY_APPROVAL", "DISCOVERING_DATA", "AWAITING_DATASET_APPROVAL",
    "AWAITING_SEARCH_REVIEW", "CURATING_DATA",
    "AWAITING_LABEL_APPROVAL", "RESOLVING_IDENTITIES", "AUDITING_DATASET",
    "AUDITING_LEAKAGE", "AWAITING_TRAINING_APPROVAL", "TRAINING", "EVALUATING",
    "AWAITING_SCIENTIFIC_APPROVAL", "REGISTERING", "COMPLETED", "FAILED", "PAUSED",
    "CANCELLED"
  ],
  "transitions": [
    {"from":"DRAFT","to":"SPECIFYING_TARGET_DATASET","initiator":"human","guard":"training-dataset workflow start explicitly authorized","required_artifacts":["endpoint_definition","blind_context_audit"]},
    {"from":"SPECIFYING_TARGET_DATASET","to":"AWAITING_DATASET_SPECIFICATION_APPROVAL","initiator":"orchestrator","guard":"strict target training-dataset specification produced","required_artifacts":["training_dataset_specification"]},
    {"from":"AWAITING_DATASET_SPECIFICATION_APPROVAL","to":"DERIVING_COMPONENT_REQUIREMENTS","initiator":"human","guard":"target specification approved with immutable hash binding","required_artifacts":["dataset_specification_approval"]},
    {"from":"AWAITING_DATASET_SPECIFICATION_APPROVAL","to":"SPECIFYING_TARGET_DATASET","initiator":"human","guard":"target specification revision requested","required_artifacts":["review_decision"]},
    {"from":"DERIVING_COMPONENT_REQUIREMENTS","to":"DISCOVERING_ACTIVITY_EVIDENCE","initiator":"orchestrator","guard":"component requirements derived deterministically","required_artifacts":["component_requirements"]},
    {"from":"DISCOVERING_ACTIVITY_EVIDENCE","to":"DISCOVERING_TRANSCRIPTOMIC_EVIDENCE","initiator":"orchestrator","guard":"bounded activity discovery fragment persisted","required_artifacts":["activity_source_inventory_fragment"]},
    {"from":"DISCOVERING_TRANSCRIPTOMIC_EVIDENCE","to":"DISCOVERING_IDENTITY_AND_STRUCTURE_SOURCES","initiator":"orchestrator","guard":"bounded transcriptomic discovery fragment persisted","required_artifacts":["transcriptomic_source_inventory_fragment"]},
    {"from":"DISCOVERING_IDENTITY_AND_STRUCTURE_SOURCES","to":"DISCOVERING_SUPPORTING_METADATA","initiator":"orchestrator","guard":"bounded identity and structure discovery fragment persisted","required_artifacts":["identity_source_inventory_fragment"]},
    {"from":"DISCOVERING_SUPPORTING_METADATA","to":"VALIDATING_DISCOVERED_SOURCES","initiator":"orchestrator","guard":"optional supporting metadata discovery completed or explicitly unnecessary","required_artifacts":["supporting_metadata_inventory_fragment"]},
    {"from":"VALIDATING_DISCOVERED_SOURCES","to":"BUILDING_SOURCE_INVENTORY","initiator":"orchestrator","guard":"source records validated against official adapters","required_artifacts":["validated_source_records"]},
    {"from":"BUILDING_SOURCE_INVENTORY","to":"PLANNING_ASSEMBLY_STRATEGIES","initiator":"orchestrator","guard":"verified inventory and deterministic capability matrix exist","required_artifacts":["verified_source_inventory","source_capability_matrix"]},
    {"from":"PLANNING_ASSEMBLY_STRATEGIES","to":"EVALUATING_JOINABILITY","initiator":"orchestrator","guard":"strategies reference only inventory sources","required_artifacts":["assembly_strategies"]},
    {"from":"EVALUATING_JOINABILITY","to":"IDENTIFYING_ASSEMBLY_GAPS","initiator":"orchestrator","guard":"deterministic joinability diagnostics persisted","required_artifacts":["joinability_diagnostics"]},
    {"from":"IDENTIFYING_ASSEMBLY_GAPS","to":"GAP_DIRECTED_DISCOVERY","initiator":"orchestrator","guard":"blocking gaps remain and bounded search round is available","required_artifacts":["assembly_gap_report"]},
    {"from":"IDENTIFYING_ASSEMBLY_GAPS","to":"COMPARING_ASSEMBLY_STRATEGIES","initiator":"orchestrator","guard":"no further bounded discovery is needed or allowed","required_artifacts":["assembly_gap_report"]},
    {"from":"GAP_DIRECTED_DISCOVERY","to":"VALIDATING_DISCOVERED_SOURCES","initiator":"orchestrator","guard":"new non-duplicate source candidates persisted","required_artifacts":["gap_discovery_fragment"]},
    {"from":"COMPARING_ASSEMBLY_STRATEGIES","to":"AWAITING_ASSEMBLY_STRATEGY_APPROVAL","initiator":"orchestrator","guard":"reviewable strategy comparison and preparation plan persisted","required_artifacts":["assembly_strategy_comparison","training_dataset_preparation_plan"]},
    {"from":"AWAITING_ASSEMBLY_STRATEGY_APPROVAL","to":"COMPLETED","initiator":"human","guard":"assembly strategy approved with immutable source graph and plan hashes; deterministic construction remains deferred","required_artifacts":["training_dataset_assembly_strategy_approval"]},
    {"from":"AWAITING_ASSEMBLY_STRATEGY_APPROVAL","to":"GAP_DIRECTED_DISCOVERY","initiator":"human","guard":"reviewer requests a bounded missing-component search","required_artifacts":["review_decision","assembly_gap_report"]},
    {"from":"AWAITING_ASSEMBLY_STRATEGY_APPROVAL","to":"PLANNING_ASSEMBLY_STRATEGIES","initiator":"human","guard":"reviewer requests strategy revision or selects an alternative","required_artifacts":["review_decision","verified_source_inventory","source_capability_matrix"]},
    {"from":"DRAFT","to":"DISCOVERING_DATA","initiator":"human","guard":"approved endpoint_definition artifact","required_artifacts":["endpoint_definition"]},
    {"from":"DISCOVERING_DATA","to":"AWAITING_DATASET_APPROVAL","initiator":"orchestrator","guard":"valid cited candidate recommendation","required_artifacts":["search_trace","dataset_candidates"]},
    {"from":"DISCOVERING_DATA","to":"AWAITING_SEARCH_REVIEW","initiator":"orchestrator","guard":"explicit cited no-candidate result requiring human search revision review","required_artifacts":["search_trace","dataset_candidates"]},
    {"from":"AWAITING_DATASET_APPROVAL","to":"CURATING_DATA","initiator":"human","guard":"approved dataset_selection bound to candidate hash","required_artifacts":["dataset_selection_approval"]},
    {"from":"AWAITING_DATASET_APPROVAL","to":"DISCOVERING_DATA","initiator":"human","guard":"revision requested","required_artifacts":["review_decision"]},
    {"from":"AWAITING_SEARCH_REVIEW","to":"DISCOVERING_DATA","initiator":"human","guard":"revised search requested","required_artifacts":["review_decision"]},
    {"from":"CURATING_DATA","to":"AWAITING_LABEL_APPROVAL","initiator":"orchestrator","guard":"checksummed source inspection and valid label proposal","required_artifacts":["source_snapshot","sample_inspection","curation_proposal","label_proposal"]},
    {"from":"AWAITING_LABEL_APPROVAL","to":"RESOLVING_IDENTITIES","initiator":"human","guard":"approved label_rules bound to curation artifacts","required_artifacts":["label_rules_approval"]},
    {"from":"AWAITING_LABEL_APPROVAL","to":"CURATING_DATA","initiator":"human","guard":"revision requested","required_artifacts":["review_decision"]},
    {"from":"RESOLVING_IDENTITIES","to":"AUDITING_DATASET","initiator":"orchestrator","guard":"identity report complete and all blocking conflicts resolved/excluded","required_artifacts":["identity_mapping","identity_coverage","identity_conflict_decisions"]},
    {"from":"AUDITING_DATASET","to":"AUDITING_LEAKAGE","initiator":"orchestrator","guard":"candidate table built and quality gate passed","required_artifacts":["candidate_table","dataset_quality_report","dataset_card","quality_gate"]},
    {"from":"AUDITING_LEAKAGE","to":"AWAITING_TRAINING_APPROVAL","initiator":"orchestrator","guard":"compound-level leakage audit passed","required_artifacts":["split_manifest","leakage_audit"]},
    {"from":"AWAITING_TRAINING_APPROVAL","to":"TRAINING","initiator":"human","guard":"approved training_authorization bound to dataset/config hashes","required_artifacts":["training_approval","training_config"]},
    {"from":"TRAINING","to":"EVALUATING","initiator":"orchestrator","guard":"candidate models and predictions complete","required_artifacts":["candidate_models","training_log"]},
    {"from":"EVALUATING","to":"AWAITING_SCIENTIFIC_APPROVAL","initiator":"orchestrator","guard":"metrics, uncertainty, calibration, selection and cards valid","required_artifacts":["evaluation_report","model_selection","model_card","dataset_card","endpoint_candidate"]},
    {"from":"AWAITING_SCIENTIFIC_APPROVAL","to":"REGISTERING","initiator":"human","guard":"model_acceptance and separate endpoint_registration approvals bound to candidate hash","required_artifacts":["model_acceptance_approval","registration_approval"]},
    {"from":"AWAITING_SCIENTIFIC_APPROVAL","to":"TRAINING","initiator":"human","guard":"revision requested with newly approved training config","required_artifacts":["review_decision","training_approval"]},
    {"from":"REGISTERING","to":"COMPLETED","initiator":"orchestrator","guard":"atomic publish plus registry/API/product verification","required_artifacts":["publish_receipt","serving_verification"]}
  ],
  "global_transitions": [
    {"from":"non_terminal_non_registering","to":"PAUSED","initiator":"human","guard":"no uninterruptible commit section"},
    {"from":"PAUSED","to":"paused_from_state","initiator":"human","guard":"all original state guards and artifact checksums remain valid"},
    {"from":"non_terminal","to":"CANCELLED","initiator":"human","guard":"cooperative cancellation acknowledged or no worker active"},
    {"from":"active_stage","to":"FAILED","initiator":"orchestrator","guard":"normalized stage failure persisted"},
    {"from":"FAILED","to":"failed_from_state","initiator":"human","guard":"failure retryable, retry authorized, new step attempt and idempotency key"}
  ],
  "invalid_transition_policy": "Reject with conflict; return current state, version, allowed transitions and unmet guards. Never skip a state or infer approval.",
  "checkpoint_policy": "Commit state/event and immutable output artifact references in one DB transaction after every bounded activity.",
  "idempotency_policy": "Logical output is keyed by workflow, stage, input artifact hashes, tool/config version and idempotency key. Repeated identical commands return the prior result.",
  "restart_policy": "Reconcile stale running attempts, verify artifacts, then requeue idempotent activities or enter FAILED. Pending approvals and PAUSED survive unchanged."
}
