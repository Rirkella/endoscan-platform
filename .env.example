# EndoScan environment variables (example).
# Copy to .env (git-ignored) and fill in as needed. No secrets are required at M0.

# --- API (placeholder; the FastAPI service is wired up in a later milestone) ---
# ENDOSCAN_API_HOST=0.0.0.0
# ENDOSCAN_API_PORT=8000

# Required to enable the supporting-literature capability. Use a monitored project contact.
# NCBI_EMAIL=research-contact@example.org
# NCBI_TOOL=endoscan
# NCBI_API_KEY=

# --- Registry / model paths (defaults are usually fine) ---
# ENDOSCAN_REGISTRY_DIR=registry
# ENDOSCAN_MODELS_DIR=models

# --- Phase-0 agent workflow administration (local development only) ---
# Admin write routes fail closed unless this exact development mode is enabled.
# Production authentication and authorization are intentionally deferred; never enable this
# setting on an externally reachable deployment.
# ENDOSCAN_ADMIN_MODE=development
# ENDOSCAN_WORKFLOW_DB=.endoscan/workflows.db
# ENDOSCAN_ARTIFACT_ROOT=.endoscan/artifacts
