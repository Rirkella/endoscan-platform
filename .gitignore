# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Secrets / local env
.env
.env.local

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Model artifacts: SMALL TEXT is git-tracked. Serve-ready model.pkl binaries are committed
# directly (Option A) via per-endpoint negations below; anything else stays ignored.
# (Re-include directories first so git can traverse into them, then track text.)
/models/**
!/models/**/
!/models/.gitkeep
!/models/**/.gitkeep
!/models/**/*.dvc
!/models/**/*.json
!/models/**/*.md
# Explore data-space support vectors: the committed, checksum-transferred k-NN backing for
# models/<ENDPOINT>/explore/ (transferred after review, like model.pkl). JSON/manifest are
# already tracked by the *.json rule above; this re-includes the small numeric .npy too.
!/models/**/explore/*.npy

# Raw / large data (never committed to raw git). The staged-data root keeps a
# .gitkeep; staged extracts under data/staged/<endpoint>/ are DVC-tracked.
/data/*
!/data/staged/
/data/staged/*
!/data/staged/.gitkeep
# Reactome enrichment gene-set artifact: committed reference data the API reads (transferred
# via operator checksum after extraction, since reactome.org is network-blocked here). Small JSON.
!/data/reactome/
!/data/reactome/**
# Small, curated metadata that maps verified PubChem identities to committed measured
# signatures. This is application reference data, not a raw transcriptomics dump.
!/data/catalogue/
!/data/catalogue/**
*.h5
*.h5ad
*.parquet
*.pkl

# Serving artifacts (Option A): endpoint model.pkl binaries are COMMITTED directly. These
# negations must follow the *.pkl rule above (last-match wins) to re-include exactly these
# files; all other *.pkl stay ignored.
# - AR: ~40 KB ridge_logreg pipeline.
# - ER: ~1.5 MB random_forest; the DVC pointer (model.pkl.dvc) was removed after a proven-
#   identical rebuild (md5 5bed2e0d…) — the real binary is now committed, not DVC-tracked.
!/models/AR/model.pkl
!/models/ER/model.pkl

# OS cruft
.DS_Store
Thumbs.db

# Node (frontend, wired up in a later milestone)
node_modules/

# Never ignore small committed test fixtures, even if they match the binary
# patterns above (M1/M2 commit dummy .pkl and data fixtures under here).
!tests/fixtures/
!tests/fixtures/**

# Builder-agent build workspaces (scratch; auditable but not committed)
/.builds/

# Job-runner local storage root (LocalStorage default; persistent disk on the server)
/.endoscan-data/
